# Firebase web app config — copy to .env and fill in with your project's values.
# Only VITE_-prefixed variables are exposed to the client by Vite.
VITE_API_KEY=your-api-key
VITE_AUTH_DOMAIN=your-project.firebaseapp.com
VITE_PROJECT_ID=your-project-id
VITE_STORAGE_BUCKET=your-project.firebasestorage.app
VITE_MESSAGING_SENDER_ID=000000000000
VITE_APP_ID=1:000000000000:web:abcdef
